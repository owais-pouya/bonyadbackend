# Copy to .env for local work. On Vercel, set these in Project > Settings > Environment Variables.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PORT=4000
# Comma-separated list of allowed browser origins (only needed if the browser calls this API directly)
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
# Optional. Defaults: Secure=true in production, false in development; SameSite=lax
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-password-of-8-or-more-characters
